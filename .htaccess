# ORBITAL // COMMAND — static site.
#
# The previous version of this file set "Options +ExecCGI", registered .py as a CGI
# handler, and rewrote every non-file request into passenger_wsgi.py. That WSGI shim
# imported app.main / a2wsgi, which do not exist in this project, so any deep link
# returned the plain-text string "Orbital CRM static server running." It also exposed
# scraper.py as a web-executable endpoint. ORBITAL is pure static HTML — no Python runs
# on the host; scraper.py runs only inside GitHub Actions.

DirectoryIndex index.html

# Never serve the scraper, its config, or the runtime artifacts over the web.
<FilesMatch "\.(py|pyc|csv|md|yml|yaml)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(requirements\.txt|config\.json|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # companies.json and index.html change with every build — never cache them hard.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
